APP_NAME=Chinese Learning Core
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/chinese_app
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Primary LLM provider (ai-box.vn / DeepSeek)
DEEPSEEK_API_KEY=

# Optional comma-separated fallback keys (vilao.ai / Gemini)
GEMINI_API_KEYS=

# Native Google AI Studio keys (generativelanguage.googleapis.com).
# Dùng chung cho speech (pronunciation + voice chat) và TTS. Comma-separated.
GEMINI_NATIVE_API_KEYS=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# SMTP — gửi email đặt lại mật khẩu. Bỏ trống SMTP_HOST để tắt gửi thật (chỉ
# log link ra console — tiện cho dev). FRONTEND_URL dùng để dựng link reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30
