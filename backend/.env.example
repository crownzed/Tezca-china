APP_NAME=Chinese Learning Core
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/chinese_app
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Provider LLM mặc định cho sinh câu hỏi + enrichment: relay vilao.ai.
# Comma-separated — mỗi key là một "lượt", key cạn quota thì tự sang key kế tiếp.
# Để trống -> mọi tính năng cần AI tự tắt (quiz rơi về ngân hàng câu hỏi tĩnh).
GEMINI_API_KEYS=

# Đổi provider LLM không cần sửa code: ba biến này, khi đặt, thắng GEMINI_* ở
# trên. Mọi relay đang dùng đều là OpenAI-compatible /chat/completions, nên
# LLM_API_URL nhận cả URL gốc (".../v1") lẫn URL đầy đủ.
# Ví dụ đã kiểm chứng: LLM_API_URL=https://gilotex.io.vn/v1 với LLM_MODEL=grok-4.5
LLM_API_URL=
LLM_API_KEYS=
LLM_MODEL=
# json_object mode: chỉ bật khi relay hỗ trợ response_format (vilao thì không).
LLM_JSON_MODE=false
# Ngân sách reasoning: "low" / "medium" / "high". Để trống -> không gửi tham số
# (relay không hỗ trợ sẽ lỗi nếu gửi). Với grok-4.5 trên gilotex, cùng một bundle
# ở mặc định mất 103s và bị gateway cắt ở ~121s, còn "low" chỉ 13-18s và trả JSON
# đầy đủ (finish_reason=stop) — đây là đòn giảm latency có tác dụng thật, không
# phải cắt bớt prompt.
LLM_REASONING_EFFORT=

# Native Google AI Studio keys (generativelanguage.googleapis.com).
# Dùng chung cho speech (pronunciation + voice chat) và TTS. Comma-separated.
GEMINI_NATIVE_API_KEYS=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# SMTP — gửi email đặt lại mật khẩu. Bỏ trống SMTP_HOST để tắt gửi thật (chỉ
# log link ra console — tiện cho dev). FRONTEND_URL dùng để dựng link reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30

# Single admin (một tài khoản quản trị duy nhất, tách khỏi luồng user thường).
# Bỏ trống cả hai -> mọi route /api/admin/* trả 503 "admin not configured".
# ADMIN_PASSWORD_HASH là bcrypt hash (KHÔNG phải mật khẩu thô). Sinh hash bằng:
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('mat-khau-cua-ban'))"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
