APP_NAME=Chinese Learning Core
# "production" bật các kiểm tra cứng lúc khởi động — hiện là: từ chối boot khi
# JWT_SECRET còn giá trị mặc định công khai trong repo. Biến này TỪNG không được
# đặt ở đâu cả (fly.toml [env] chỉ có PORT), nên lớp chắn đó là code chết trên
# máy production thật. Đặt ENV=production trên môi trường triển khai; nhớ đặt
# JWT_SECRET TRƯỚC, vì thiếu nó thì app sẽ (đúng như thiết kế) không khởi động.
ENV=development
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/chinese_app
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Trần kích thước request body (byte), chặn ở middleware TRƯỚC routing. Không có
# nó thì một request body ~300MB làm OOM máy 512MB, vì FastAPI đọc trọn body vào
# RAM trước khi validator/rate-limit nào chạy. Đừng hạ xuống dưới ~900KB:
# audio_base64 có trần 700_000 ký tự và sẽ bị chặn oan.
MAX_REQUEST_BYTES=1500000

# --- Provider LLM (sinh câu hỏi + enrichment) ---
# Thứ tự ưu tiên, dừng ở cái đầu tiên có key: LLM_API_KEYS -> STEPFUN_API_KEYS
# -> GEMINI_API_KEYS. Nói cách khác: chỉ cần đặt STEPFUN_API_KEYS (khối dưới) là
# StepFun tự thành provider chính, không phải khai thêm URL/model gì.
# Hết cả ba -> mọi tính năng cần AI tự tắt (quiz rơi về ngân hàng câu hỏi tĩnh).

# Relay vilao.ai — đường DỰ PHÒNG, chỉ dùng khi hai nguồn trên trống.
GEMINI_API_KEYS=

# Ghi đè provider thủ công: ba biến này thắng tất cả. Mọi provider đang dùng đều
# OpenAI-compatible /chat/completions, nên LLM_API_URL nhận cả URL gốc (".../v1")
# lẫn URL đầy đủ.
# PHẢI đặt cả ba hoặc để trống cả ba. Đặt lẻ một biến sẽ ghép URL của provider này
# với key của provider kia (vd chỉ có LLM_API_URL -> URL custom + key StepFun) và
# chỉ lộ ra dưới dạng 401/404 lúc chạy, nên backend từ chối khởi động luôn.
# Ví dụ đã kiểm chứng: LLM_API_URL=https://gilotex.io.vn/v1 với LLM_MODEL=grok-4.5
LLM_API_URL=
LLM_API_KEYS=
LLM_MODEL=
# json_object mode. Để TRỐNG = tự quyết theo provider (StepFun hỗ trợ -> bật;
# vilao không hỗ trợ -> tắt, JSON ép bằng system prompt). true/false để ghi đè.
LLM_JSON_MODE=
# Ngân sách reasoning: "low" / "medium" / "high". Để trống = tự quyết theo
# provider (StepFun -> "low"; vilao -> không gửi vì không nhận tham số này).
# Đây là đòn giảm latency có tác dụng thật, không phải cắt bớt prompt: đo trên
# StepFun step-3.7-flash cùng một prompt, mặc định 29s/3749 token, còn
# json_object + low chỉ 6s/457 token. Trần gateway ~121s.
LLM_REASONING_EFFORT=

# Native Google AI Studio keys (generativelanguage.googleapis.com).
# Dùng chung cho speech (pronunciation + voice chat) và TTS. Comma-separated.
# Nhiều key = xoay vòng khi một key 429; đây là lý do Gemini vẫn giữ vai fallback
# cho ASR dù StepFun nhanh hơn (Step Plan chỉ có 1 key).
GEMINI_NATIVE_API_KEYS=
# CHỈ model này được thử — không còn danh sách model dự phòng (nó chỉ làm ladder
# dài gấp 3 mà không cứu được ca lỗi nào). Đặt sai tên ở đây là 404 mọi request,
# nên giữ khớp với giá trị đang chạy.
GEMINI_NATIVE_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# StepFun Step Plan — dùng CHUNG một bộ key cho cả chat (sinh câu hỏi) và TTS.
# Đặt key ở đây là StepFun tự thành provider LLM chính (xem khối provider trên).
# Không commit key thật; dùng key lấy từ StepFun console.
STEPFUN_API_KEYS=
# Chat. Path /step_plan/v1 là bắt buộc với key Step Plan: đo trên key thật,
# /step_plan/v1 trả 200 còn /v1 (trả tiền theo token) trả 402 quota_exceeded.
STEPFUN_CHAT_URL=https://api.stepfun.ai/step_plan/v1/chat/completions
STEPFUN_CHAT_MODEL=step-3.7-flash
STEPFUN_TTS_URL=https://api.stepfun.ai/step_plan/v1/audio/speech
STEPFUN_TTS_MODEL=stepaudio-2.5-tts
STEPFUN_TTS_VOICE=zixinnansheng
STEPFUN_TTS_INSTRUCTION=标准普通话，清晰、自然、语速稍慢，准确读出声调。
# Chỉ dẫn RIÊNG cho hội thoại (/tts/stream): sinh động hơn vì giọng đóng vai người
# đối thoại, không phải máy đọc từ điển. Đo trên key thật so với chuỗi trên:
# F0 trung vị 116->129Hz (+11%), cường độ +2.0dB, ASR chép lại vẫn khớp (thanh
# điệu không méo). Sửa chuỗi này thì phải dùng từ DỨT KHOÁT ("音调偏高") — mô tả
# mơ hồ kiểu "语调有自然起伏" đo ra không khác gì bản trung tính. Giữ mệnh đề
# "声调准确清晰" ở cuối: sai thanh điệu là phản tác dụng với app học tiếng.
STEPFUN_TTS_INSTRUCTION_CHAT=热情洋溢的中文老师，音调偏高，语气积极上扬，重音明显，语速适中；标准普通话，声调准确清晰。
# Tốc độ MẶC ĐỊNH khi request không truyền `speed`. Client hội thoại luôn truyền
# (bộ chọn 0.72/0.82/0.95), nên biến này chủ yếu áp cho flashcard/quiz và script
# dựng kho audio. Backend kẹp về [0.5, 2.0] chứ không trả lỗi: URL /tts nằm trong
# `new Audio(src)`, và một 422 ở đó chỉ hiện ra dưới dạng im lặng không lý do.
#
# Tốc độ đi vào REQUEST, KHÔNG dùng playbackRate của browser: provider tổng hợp lại
# từ đầu, còn browser resample luồng đã nén. Trước đây client kéo playbackRate với
# sàn cứng 0.85, nên hai mức chậm nhất (0.72 và 0.82) cho ra audio Y HỆT NHAU.
# Đo trên key thật: 0.72 -> 301ms/chữ, 0.82 -> 261, 0.95 -> 204; ASR khớp 3/3.
STEPFUN_TTS_SPEED=0.9
STEPFUN_TTS_SAMPLE_RATE=24000
STEPFUN_TTS_TEXT_NORMALIZATION=enhanced
# ASR — chép âm cho hội thoại. Là đường CHÍNH khi có STEPFUN_API_KEYS; Gemini
# native vẫn là fallback (chỉ có 1 key Step Plan, không xoay vòng được).
# Chỉ có bản HTTP+SSE: Step Plan không mở bản WebSocket song hướng.
STEPFUN_ASR_URL=https://api.stepfun.ai/step_plan/v1/audio/asr/sse
STEPFUN_ASR_MODEL=stepaudio-2.5-asr

# SMTP — gửi email đặt lại mật khẩu. Bỏ trống SMTP_HOST để tắt gửi thật.
# FRONTEND_URL dùng để dựng link reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30
# CHỈ đặt =1 trên máy dev. Bật thì nội dung mail — kèm link reset chứa token thô,
# còn hiệu lực 30 phút — được in nguyên văn ra log khi SMTP chưa cấu hình. Mặc
# định tắt, và mốc là cờ riêng này chứ KHÔNG phải ENV: điều kiện cũ
# ("không phải production") là fail-open, và nó đã mở thật vì ENV không được đặt.
EMAIL_DEBUG_LOG=0

# Single admin (một tài khoản quản trị duy nhất, tách khỏi luồng user thường).
# Bỏ trống cả hai -> mọi route /api/admin/* trả 503 "admin not configured".
# ADMIN_PASSWORD_HASH là bcrypt hash (KHÔNG phải mật khẩu thô). Sinh hash bằng:
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('mat-khau-cua-ban'))"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
